#!/bin/bash
#
# Sentinel Linux Installer
# ========================
# Installs Sentinel Linux to disk with encryption
#

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Configuration
SENTINEL_VERSION="1.0.0"

banner() {
    clear
    echo -e "${CYAN}"
    echo "╔═══════════════════════════════════════════════════════════════╗"
    echo "║                                                               ║"
    echo "║   ███████╗███████╗███╗   ██╗████████╗██╗███╗   ██╗███████╗██╗ ║"
    echo "║   ██╔════╝██╔════╝████╗  ██║╚══██╔══╝██║████╗  ██║██╔════╝██║ ║"
    echo "║   ███████╗█████╗  ██╔██╗ ██║   ██║   ██║██╔██╗ ██║█████╗  ██║ ║"
    echo "║   ╚════██║██╔══╝  ██║╚██╗██║   ██║   ██║██║╚██╗██║██╔══╝  ██║ ║"
    echo "║   ███████║███████╗██║ ╚████║   ██║   ██║██║ ╚████║███████╗███████╗ ║"
    echo "║   ╚══════╝╚══════╝╚═╝  ╚═══╝   ╚═╝   ╚═╝╚═╝  ╚═══╝╚══════╝╚══════╝ ║"
    echo "║                                                               ║"
    echo "║           Sentinel Linux Installer v${SENTINEL_VERSION}                    ║"
    echo "║           AI-Powered Security Distribution                    ║"
    echo "║                                                               ║"
    echo "╚═══════════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
    echo ""
}

log() {
    echo -e "${GREEN}[INSTALL]${NC} $1"
}

warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1"
    exit 1
}

step() {
    echo -e "\n${CYAN}===> $1${NC}"
}

# Check if running as root
check_root() {
    if [ "$EUID" -ne 0 ]; then
        error "This installer must be run as root"
    fi
}

# List available disks
list_disks() {
    step "Available Disks"
    echo ""
    lsblk -d -o NAME,SIZE,TYPE,MODEL | grep -E "^(NAME|sd|nvme|vd)"
    echo ""
}

# Select installation disk
select_disk() {
    while true; do
        echo -n "Enter target disk (e.g., sda, nvme0n1, vda): "
        read TARGET_DISK

        if [ -b "/dev/${TARGET_DISK}" ]; then
            echo -e "\n${YELLOW}WARNING: All data on /dev/${TARGET_DISK} will be DESTROYED!${NC}"
            echo -n "Are you sure? (yes/no): "
            read CONFIRM

            if [ "$CONFIRM" = "yes" ]; then
                TARGET_DEV="/dev/${TARGET_DISK}"
                break
            fi
        else
            warn "Disk /dev/${TARGET_DISK} not found. Try again."
        fi
    done
}

# Setup encryption
setup_encryption() {
    step "Setting up Full Disk Encryption (LUKS2)"

    echo ""
    echo "You will now set a passphrase for disk encryption."
    echo "This passphrase will be required at every boot."
    echo ""

    # Create partitions
    log "Creating partitions..."

    # Determine partition naming (nvme uses p1, sda uses 1)
    if [[ "$TARGET_DEV" == *"nvme"* ]]; then
        PART_PREFIX="${TARGET_DEV}p"
    else
        PART_PREFIX="${TARGET_DEV}"
    fi

    # Clear existing partitions
    sgdisk -Z "$TARGET_DEV" 2>/dev/null || true

    # Create GPT partitions
    # 1: EFI System Partition (512MB)
    # 2: Boot partition (1GB, unencrypted for GRUB)
    # 3: Encrypted root partition (rest)
    sgdisk -n 1:0:+512M -t 1:ef00 -c 1:"EFI" "$TARGET_DEV"
    sgdisk -n 2:0:+1G -t 2:8300 -c 2:"Boot" "$TARGET_DEV"
    sgdisk -n 3:0:0 -t 3:8309 -c 3:"Root" "$TARGET_DEV"

    partprobe "$TARGET_DEV"
    sleep 2

    EFI_PART="${PART_PREFIX}1"
    BOOT_PART="${PART_PREFIX}2"
    ROOT_PART="${PART_PREFIX}3"

    # Setup LUKS encryption on root partition
    log "Setting up LUKS encryption..."
    cryptsetup luksFormat --type luks2 \
        --cipher aes-xts-plain64 \
        --key-size 512 \
        --hash sha512 \
        --pbkdf argon2id \
        --label sentinel-root \
        "$ROOT_PART"

    log "Opening encrypted partition..."
    cryptsetup open "$ROOT_PART" sentinel-root

    CRYPT_DEV="/dev/mapper/sentinel-root"
}

# Format partitions
format_partitions() {
    step "Formatting Partitions"

    log "Formatting EFI partition..."
    mkfs.vfat -F32 -n "EFI" "$EFI_PART"

    log "Formatting boot partition..."
    mkfs.ext4 -L "sentinel-boot" "$BOOT_PART"

    log "Formatting root partition..."
    mkfs.ext4 -L "sentinel-root" "$CRYPT_DEV"
}

# Mount partitions
mount_partitions() {
    step "Mounting Partitions"

    MOUNT_ROOT="/mnt/sentinel"

    mkdir -p "$MOUNT_ROOT"
    mount "$CRYPT_DEV" "$MOUNT_ROOT"

    mkdir -p "$MOUNT_ROOT/boot"
    mount "$BOOT_PART" "$MOUNT_ROOT/boot"

    mkdir -p "$MOUNT_ROOT/boot/efi"
    mount "$EFI_PART" "$MOUNT_ROOT/boot/efi"

    log "Partitions mounted at $MOUNT_ROOT"
}

# Copy system files
install_system() {
    step "Installing Sentinel Linux"

    # Find the live system mount
    LIVE_ROOT=""
    for mount in /run/live/rootfs /newroot/live /; do
        if [ -d "$mount/opt/sentinel" ]; then
            LIVE_ROOT="$mount"
            break
        fi
    done

    if [ -z "$LIVE_ROOT" ]; then
        LIVE_ROOT="/"
    fi

    log "Copying system files from $LIVE_ROOT..."

    # Copy root filesystem
    rsync -aAXHv --exclude={"/dev/*","/proc/*","/sys/*","/tmp/*","/run/*","/mnt/*","/media/*","/lost+found"} \
        "$LIVE_ROOT/" "$MOUNT_ROOT/"

    # Create required directories
    mkdir -p "$MOUNT_ROOT"/{dev,proc,sys,tmp,run,mnt,media}
    chmod 1777 "$MOUNT_ROOT/tmp"

    log "System files copied"
}

# Configure bootloader
configure_bootloader() {
    step "Configuring Bootloader"

    # Get UUID of encrypted partition
    ROOT_UUID=$(blkid -s UUID -o value "$ROOT_PART")
    CRYPT_UUID=$(blkid -s UUID -o value "$CRYPT_DEV")

    # Create crypttab
    log "Creating /etc/crypttab..."
    echo "sentinel-root UUID=${ROOT_UUID} none luks,discard" > "$MOUNT_ROOT/etc/crypttab"

    # Create fstab
    log "Creating /etc/fstab..."
    cat > "$MOUNT_ROOT/etc/fstab" << FSTAB
# Sentinel Linux fstab
# <device>                                 <mount>     <type>  <options>           <dump> <pass>
UUID=${CRYPT_UUID}                         /           ext4    defaults,noatime    0      1
UUID=$(blkid -s UUID -o value "$BOOT_PART") /boot       ext4    defaults,noatime    0      2
UUID=$(blkid -s UUID -o value "$EFI_PART")  /boot/efi   vfat    umask=0077          0      2
tmpfs                                      /tmp        tmpfs   defaults,nosuid,nodev,noexec 0 0
FSTAB

    # Install GRUB
    log "Installing GRUB bootloader..."

    # Mount required filesystems for chroot
    mount --bind /dev "$MOUNT_ROOT/dev"
    mount --bind /dev/pts "$MOUNT_ROOT/dev/pts"
    mount --bind /proc "$MOUNT_ROOT/proc"
    mount --bind /sys "$MOUNT_ROOT/sys"

    # Install GRUB in chroot
    chroot "$MOUNT_ROOT" /bin/sh -c "
        grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=sentinel --recheck
        grub-install --target=i386-pc ${TARGET_DEV} 2>/dev/null || true
    "

    # Create GRUB config
    log "Generating GRUB configuration..."
    cat > "$MOUNT_ROOT/etc/default/grub" << 'GRUBCFG'
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="Sentinel Linux"
GRUB_CMDLINE_LINUX_DEFAULT="quiet"
GRUB_CMDLINE_LINUX="cryptdevice=UUID=${ROOT_UUID}:sentinel-root root=/dev/mapper/sentinel-root"
GRUB_PRELOAD_MODULES="part_gpt part_msdos cryptodisk luks2"
GRUB_ENABLE_CRYPTODISK=y
GRUB_DISABLE_OS_PROBER=true
GRUBCFG

    # Substitute actual UUID
    sed -i "s/\${ROOT_UUID}/${ROOT_UUID}/g" "$MOUNT_ROOT/etc/default/grub"

    # Generate GRUB config
    chroot "$MOUNT_ROOT" /bin/sh -c "grub-mkconfig -o /boot/grub/grub.cfg"

    # Unmount bind mounts
    umount "$MOUNT_ROOT/sys"
    umount "$MOUNT_ROOT/proc"
    umount "$MOUNT_ROOT/dev/pts"
    umount "$MOUNT_ROOT/dev"

    log "Bootloader configured"
}

# Configure Sentinel daemon
configure_sentinel() {
    step "Configuring Sentinel Security Daemon"

    # Prompt for API key
    echo ""
    echo "Sentinel can use AI-powered threat analysis with Claude."
    echo "You can enter your Anthropic API key now, or skip and add it later."
    echo ""
    echo -n "Enter Anthropic API key (or press Enter to skip): "
    read -s API_KEY
    echo ""

    if [ -n "$API_KEY" ]; then
        # Update Sentinel config with API key
        if [ -f "$MOUNT_ROOT/etc/sentinel/config.json" ]; then
            # Use jq if available, otherwise sed
            if command -v jq &> /dev/null; then
                jq ".ai.api_key = \"${API_KEY}\"" "$MOUNT_ROOT/etc/sentinel/config.json" > /tmp/sentinel-config.json
                mv /tmp/sentinel-config.json "$MOUNT_ROOT/etc/sentinel/config.json"
            fi
        fi

        # Also create .env file
        echo "ANTHROPIC_API_KEY=${API_KEY}" > "$MOUNT_ROOT/opt/sentinel/.env"
        chmod 600 "$MOUNT_ROOT/opt/sentinel/.env"

        log "API key configured"
    else
        warn "Skipping API key configuration. AI features will be limited."
        warn "Add your key later to /etc/sentinel/config.json"
    fi

    # Enable Sentinel service
    log "Enabling Sentinel daemon..."
    chroot "$MOUNT_ROOT" /bin/sh -c "rc-update add sentinel default 2>/dev/null || systemctl enable sentinel 2>/dev/null || true"
}

# Create user account
create_user() {
    step "Creating User Account"

    echo ""
    echo -n "Enter username: "
    read USERNAME

    if [ -n "$USERNAME" ]; then
        chroot "$MOUNT_ROOT" /bin/sh -c "
            adduser -D -s /bin/bash -G wheel ${USERNAME} 2>/dev/null || useradd -m -s /bin/bash -G wheel ${USERNAME}
            echo '${USERNAME} ALL=(ALL) ALL' >> /etc/sudoers
        "

        echo ""
        echo "Set password for ${USERNAME}:"
        chroot "$MOUNT_ROOT" /bin/sh -c "passwd ${USERNAME}"

        log "User ${USERNAME} created"
    fi
}

# Finalize installation
finalize() {
    step "Finalizing Installation"

    # Generate SSH keys
    log "Generating SSH host keys..."
    chroot "$MOUNT_ROOT" /bin/sh -c "
        ssh-keygen -A
    "

    # Update initramfs with crypto support
    log "Updating initramfs..."
    chroot "$MOUNT_ROOT" /bin/sh -c "
        mkinitfs 2>/dev/null || update-initramfs -u 2>/dev/null || dracut -f 2>/dev/null || true
    "

    # Unmount everything
    log "Unmounting partitions..."
    umount -R "$MOUNT_ROOT"

    # Close encrypted volume
    cryptsetup close sentinel-root
}

# Main installation flow
main() {
    banner
    check_root

    echo "Welcome to the Sentinel Linux installer!"
    echo ""
    echo "This installer will:"
    echo "  1. Partition your selected disk"
    echo "  2. Set up full disk encryption (LUKS2)"
    echo "  3. Install Sentinel Linux"
    echo "  4. Configure the bootloader"
    echo "  5. Set up the Sentinel security daemon"
    echo ""
    echo -n "Press Enter to continue or Ctrl+C to abort..."
    read

    list_disks
    select_disk
    setup_encryption
    format_partitions
    mount_partitions
    install_system
    configure_bootloader
    configure_sentinel
    create_user
    finalize

    echo ""
    echo -e "${GREEN}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║           Installation Complete!                              ║${NC}"
    echo -e "${GREEN}╠═══════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${GREEN}║  Remove the installation media and reboot your system.        ║${NC}"
    echo -e "${GREEN}║                                                               ║${NC}"
    echo -e "${GREEN}║  You will be prompted for your disk encryption passphrase     ║${NC}"
    echo -e "${GREEN}║  during boot.                                                 ║${NC}"
    echo -e "${GREEN}║                                                               ║${NC}"
    echo -e "${GREEN}║  After login, run 'sentinelctl status' to verify the          ║${NC}"
    echo -e "${GREEN}║  security daemon is running.                                  ║${NC}"
    echo -e "${GREEN}║                                                               ║${NC}"
    echo -e "${GREEN}║  Thank you for choosing Sentinel Linux!                       ║${NC}"
    echo -e "${GREEN}╚═══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -n "Press Enter to reboot..."
    read

    reboot
}

main "$@"
