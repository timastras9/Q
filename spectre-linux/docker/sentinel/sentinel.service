# Spectre - Autonomous Security Daemon
# =============================================
# Inspired by Apple's Spectre/XNU kernel security philosophy
#
# Install: cp spectre.service /etc/systemd/system/
#          systemctl daemon-reload
#          systemctl enable --now spectre

[Unit]
Description=Spectre - Autonomous Security Daemon
Documentation=https://github.com/pentestai/spectre
After=network.target network-online.target
Wants=network-online.target

# Restart on failure
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
ExecStart=/usr/bin/python3 /opt/spectre/daemon.py
ExecReload=/bin/kill -HUP $MAINPID

# Security hardening (Spectre philosophy: minimal attack surface)
User=root
Group=root
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectControlGroups=true

# Resource limits
MemoryLimit=512M
CPUQuota=50%

# Restart policy - self-healing
Restart=always
RestartSec=30
TimeoutStartSec=120
TimeoutStopSec=30

# Watchdog - daemon must ping every 5 minutes or restart
WatchdogSec=300

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=SPECTRE_LOG_LEVEL=INFO

# Working directory
WorkingDirectory=/opt/spectre

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=spectre

[Install]
WantedBy=multi-user.target
