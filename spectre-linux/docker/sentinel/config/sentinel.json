{
  "version": "2.0.0",
  "sentinel": {
    "quick_scan_interval_minutes": 5,
    "standard_scan_interval_hours": 1,
    "deep_scan_interval_hours": 4,
    "watchdog_timeout_seconds": 300,
    "max_concurrent_scans": 1
  },
  "continuous_monitoring": {
    "enabled": true,
    "file_monitoring": true,
    "process_monitoring": true,
    "network_monitoring": true,
    "auth_monitoring": true
  },
  "thresholds": {
    "epss_critical": 0.8,
    "epss_high": 0.4,
    "cvss_critical": 9.0,
    "cvss_high": 7.0,
    "auth_failures_threshold": 5,
    "auth_failures_window_minutes": 10
  },
  "auto_remediation": {
    "enabled": true,
    "patch_critical": true,
    "patch_high": true,
    "patch_medium": false,
    "disable_services": true,
    "firewall_rules": true,
    "selinux_policies": true,
    "kill_suspicious_processes": true,
    "quarantine_files": true,
    "lock_users": true
  },
  "expected_ports": [22, 80, 443],
  "excluded_packages": [
    "kernel",
    "glibc",
    "systemd"
  ],
  "excluded_processes": [
    "sshd",
    "systemd",
    "sentinel"
  ],
  "threat_intel": {
    "cisa_kev_enabled": true,
    "epss_enabled": true,
    "nvd_enabled": true,
    "refresh_interval_hours": 1
  },
  "alerting": {
    "enabled": true,
    "webhook_url": "",
    "email": "",
    "slack_webhook": "",
    "alert_on_critical": true,
    "alert_on_high": true,
    "alert_on_medium": false
  },
  "logging": {
    "level": "INFO",
    "syslog_enabled": true,
    "file_enabled": true,
    "audit_trail": true
  }
}
