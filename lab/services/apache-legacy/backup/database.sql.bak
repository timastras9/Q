CREATE DATABASE IF NOT EXISTS legacy_app;
USE legacy_app;

-- Users table
CREATE TABLE users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(50),
    password VARCHAR(255),
    email VARCHAR(100),
    role VARCHAR(20),
    api_key VARCHAR(64)
);

